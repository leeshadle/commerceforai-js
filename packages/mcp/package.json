{
  "name": "@commerceforai/mcp",
  "version": "0.1.9",
  "description": "MCP server that lets AI agents operate a CommerceForAI store, with guardrails.",
  "type": "module",
  "bin": {
    "commerceforai-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "commerceforai": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "homepage": "https://commerceforai.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "commerce",
    "ecommerce",
    "stripe",
    "ai",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "com.commerceforai/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeshadle/commerceforai-js.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/leeshadle/commerceforai-js/issues"
  }
}

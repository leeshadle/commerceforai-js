---
export const prerender = false;
import Shop from "../../layouts/Shop.astro";
import { commerce, money } from "../../lib/commerce";
import { CHECKOUT, writeCart } from "../../lib/cart";

const checkoutId = Astro.cookies.get(CHECKOUT)?.value;
const { data: co } = checkoutId ? await commerce.checkouts.get(checkoutId) : { data: null };
// Stripe tells the store about the payment by webhook, usually within a second or two.
const { data: order } = co?.order_id ? await commerce.orders.get(co.order_id) : { data: null };
if (order) writeCart(Astro.cookies, []);
---
<Shop title="Thank you">
  <h1 class="cfa-h1">Thank you!</h1>
  {order ? (
    <>
      <p class="cfa-muted">Order #{order.number} is confirmed{order.email ? `. A receipt is on its way to ${order.email}` : ""}.</p>
      <table class="cfa-table"><tbody>
        {order.items.map((i) => (
          <tr><td>{i.product_name}{i.variant_name !== "Default" ? ` · ${i.variant_name}` : ""} × {i.quantity}</td><td style="text-align:right">{money(i.unit_price * i.quantity, order.currency)}</td></tr>
        ))}
        <tr><td><strong>Total</strong></td><td style="text-align:right"><strong>{money(order.total, order.currency)}</strong></td></tr>
      </tbody></table>
    </>
  ) : (
    <>
      <p class="cfa-notice">We're confirming your payment. This page refreshes in a moment.</p>
      <meta http-equiv="refresh" content="3" />
    </>
  )}
  <div class="cfa-row"><a href="/shop" class="cfa-button cfa-secondary">Keep shopping</a></div>
</Shop>
